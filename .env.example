# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file that contains actual secrets.

# A long random string used to sign JWTs for member and admin sessions.
# Required: the app cannot sign anyone in without it.
AUTH_SECRET=replace-with-a-long-random-string

# Password for community-member access (used by /api/auth/login).
# Required: member pages stay locked while this is unset.
MEMBER_PASSWORD=replace-with-member-password

# Password for administrator access (used by /api/auth/admin-login).
# Required: the admin dashboard stays locked while this is unset.
ADMIN_PASSWORD=replace-with-admin-password

# Firebase Admin SDK (needed for bulletin, calendar, gallery, store, and uploads).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"

# Firebase Storage bucket identifier. Used by the server-side Admin SDK.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Optional server-only Apify API token. Do not prefix with NEXT_PUBLIC_.
# Only configure this if an Apify-backed feature is added to the application.
APIFY_API_TOKEN=replace-with-apify-api-token

# Server-only Mistral API key for the member AI assistant (/ai-chat).
# Required for /api/ai-chat; the assistant stays disabled while this is unset.
# Never prefix with NEXT_PUBLIC_ and never commit the real key.
MISTRAL_API_KEY=replace-with-mistral-api-key

# Optional. Mistral model used by /api/ai-chat. Defaults to mistral-small-latest.
MISTRAL_MODEL=mistral-small-latest
